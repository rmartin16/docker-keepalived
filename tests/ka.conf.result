global_defs {
  enable_script_security
}

vrrp_instance VI {
  state BACKUP
  interface eth0
  virtual_router_id 51
  priority 150

  nopreempt

  unicast_peer {
    10.10.0.11
    10.10.0.12
    10.10.0.13
  }

  authentication {
    auth_type PASS
    auth_pass s3cr3t
  }

  virtual_ipaddress {
    10.10.0.100/24
    10.10.0.101/24
  }

  notify "/notify.sh"
}
